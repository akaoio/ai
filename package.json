{
    "name": "@mimiza/ai",
    "type": "module",
    "version": "1.0.1",
    "description": "Personal AI library in NodeJS",
    "main": "index.js",
    "scripts": {
        "start": "node server.js",
        "test": "node tests/test.js",
        "testff": "node tests/FF.js",
        "testneat": "node tests/NEAT.js",
        "build:wasm": "mkdir -p wasm && zig build-exe wasm/kernels.zig -target wasm32-freestanding -fno-entry --export-memory -O ReleaseSmall -rdynamic -femit-bin=wasm/kernels.wasm",
        "benchmark": "npm run build:wasm --silent && node benchmarks/run.js",
        "format": "npx prettier --write ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mimiza/ai.git"
    },
    "author": "MIMIZA",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/mimiza/ai/issues"
    },
    "homepage": "https://github.com/mimiza/ai#readme",
    "devDependencies": {
        "prettier": "2.6.2"
    }
}
